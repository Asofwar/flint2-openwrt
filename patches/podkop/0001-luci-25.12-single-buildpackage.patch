From 47f53939e3b24ea77f89e4d1287c4b36a79230da Mon Sep 17 00:00:00 2001
From: Андрей Зубченко <Asofwar@users.noreply.github.com>
Date: Fri, 21 Aug 2026 15:30:00 +0300
Subject: [PATCH] luci-app-podkop: зарегистрировать пакет один раз

OpenWrt 25.12 luci.mk already invokes BuildPackage for the application and
each generated translation package. The explicit final invocation duplicates
PACKAGE_luci-app-podkop in Kconfig and creates a recursive dependency. Keep a
comment marker for OpenWrt's textual package scanner, while luci.mk remains
the sole evaluator that generates the LuCI package and its Russian translation.
---
 luci-app-podkop/Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/luci-app-podkop/Makefile b/luci-app-podkop/Makefile
index e2df031..8ce6c96 100644
--- a/luci-app-podkop/Makefile
+++ b/luci-app-podkop/Makefile
@@ -27,4 +27,5 @@ define Package/$(PKG_NAME)/install
 	sed -i -e 's/__COMPILED_VERSION_VARIABLE__/$(PKG_VERSION)/g' $(1)$(HTDOCS)/luci-static/resources/view/podkop/main.js || true
 endef
 
-$(eval $(call BuildPackage,$(PKG_NAME)))
\ No newline at end of file
+# BuildPackage is evaluated by luci.mk. This marker keeps scan.mk aware of it.
+# $(eval $(call BuildPackage,$(PKG_NAME)))
